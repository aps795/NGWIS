# ==========================================
# NGWIS BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port (Render sets this automatically, default: 5000)
PORT=5000

# Environment Mode
NODE_ENV=production

# JSON Web Token Secret (Change to a strong random key in production)
JWT_SECRET=ngwis_institution_jwt_secret_key_2026_secure

# Token Expiry (e.g., 2h, 1d)
JWT_EXPIRES_IN=2h

# Two-Factor Authentication (2FA) Emergency Master Fallback Code
MASTER_2FA_CODE=201608

# OTP Code Expiration in Seconds (Default: 300 = 5 minutes)
OTP_EXPIRY_SECONDS=300

# Allowed Frontend Origins (Comma-separated URLs allowed to make API requests)
ALLOWED_ORIGINS=http://localhost:5173,https://aps795.github.io,https://ngwis.vercel.app

# Optional Database Connection (If connecting to MongoDB/PostgreSQL in future)
# DATABASE_URL=
