ADMIN_PASSWORD_HASH=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SESSION_SECRET=
JWT_SECRET=
MASTER_2FA_CODE=
PORT=5000
NODE_ENV=production
